    "Long-press any photo or person to report or block them. We review reports and remove people who break the rules." : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Houd een foto of persoon ingedrukt om te melden of te blokkeren. We bekijken meldingen en verwijderen mensen die de regels breken."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Appuie longuement sur une photo ou une personne pour la signaler ou la bloquer. Nous examinons les signalements et retirons les personnes qui enfreignent les règles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Drücke lange auf ein Foto oder eine Person, um sie zu melden oder zu blockieren. Wir prüfen Meldungen und entfernen Leute, die gegen die Regeln verstoßen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantén pulsada una foto o persona para denunciarla o bloquearla. Revisamos las denuncias y expulsamos a quien rompe las reglas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tieni premuta una foto o una persona per segnalarla o bloccarla. Esaminiamo le segnalazioni e rimuoviamo chi viola le regole."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantenha pressionada uma foto ou pessoa para denunciar ou bloquear. Analisamos as denúncias e removemos quem desrespeita as regras."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantenha premida uma foto ou pessoa para denunciar ou bloquear. Analisamos as denúncias e removemos quem desrespeita as regras."
          }
        }
