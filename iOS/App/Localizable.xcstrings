    "%@ is starting to sag. Snoozes and misses make him droop." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ fängt an durchzuhängen. Schlummern und Verpassen machen ihn schlapp."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ empieza a desinflarse. Posponer y fallar lo dejan blando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ commence à s’affaisser. Les répétitions et les ratés le ramollissent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ comincia ad afflosciarsi. Posticipi e mattine perse lo rendono molle."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ begint door te zakken. Snoozen en missers maken hem slap."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ está começando a murchar. Sonecas e manhãs perdidas deixam ele mole."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ está a começar a murchar. Snoozes e manhãs perdidas deixam-no mole."
          }
        }
      }
    },
