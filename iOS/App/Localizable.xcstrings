    "Just so I know who I'm waking up." : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zodat ik weet wie ik wakker maak."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Juste pour savoir qui je réveille."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nur damit ich weiß, wen ich wecke."
