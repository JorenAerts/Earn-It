    "Keep each other honest. Who's up, who's still snoozing, and who's leading this week." : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Houd elkaar eerlijk. Wie is op, wie snoozet nog, en wie staat er deze week bovenaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Restez honnêtes. Qui est debout, qui répète encore l’alarme, et qui mène cette semaine."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Haltet euch gegenseitig ehrlich. Wer ist wach, wer schlummert noch und wer führt diese Woche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantened la honestidad. Quién está en pie, quién sigue posponiendo y quién lidera esta semana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Restate onesti. Chi è in piedi, chi posticipa ancora e chi guida questa settimana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantenham a honestidade. Quem está de pé, quem ainda está na soneca e quem lidera esta semana."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantenham a honestidade. Quem está a pé, quem ainda está na snooze e quem lidera esta semana."
          }
        }
      }
    },
