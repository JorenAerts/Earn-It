    "%@ gallery" : {
      "extractionState" : "manual",
      "shouldTranslate" : false
    },
    "%@ has melted into a puddle. Three good mornings in a row will perk him up." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ist zu einer Pfütze geschmolzen. Drei gute Morgen in Folge bringen ihn wieder in Form."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ se ha derretido en un charco. Tres buenas mañanas seguidas lo animarán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ a fondu en flaque. Trois bons matins d’affilée le remettront d’aplomb."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ si è sciolto in una pozzanghera. Tre buone mattine di fila lo rimetteranno in sesto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ is gesmolten tot een plasje. Drie goede ochtenden op rij fleuren hem weer op."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ derreteu numa poça. Três manhãs boas seguidas vão animar ele de novo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ derreteu numa poça. Três boas manhãs seguidas vão animá-lo outra vez."
          }
        }
      }
    },
