    "A normal alarm takes four alarms, five minutes apart. Gloop takes one alarm and a mission." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mit einem normalen Wecker stellst du vier Alarme im Abstand von fünf Minuten. Mit Gloop reichen ein Wecker und eine Mission."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Con un despertador normal pones cuatro alarmas separadas por cinco minutos. Con Gloop basta una alarma y una misión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Avec un réveil classique, il faut quatre alarmes à cinq minutes d’intervalle. Avec Gloop, une alarme et une mission suffisent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Con una sveglia normale ne imposti quattro, a cinque minuti l’una dall’altra. Con Gloop bastano una sveglia e una missione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Met een gewone wekker zet je er vier, met vijf minuten ertussen. Met Gloop is het één wekker en een missie."
          }
        },
        "pt-BR" : {
