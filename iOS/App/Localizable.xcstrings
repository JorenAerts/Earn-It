    "Your account and profile are permanently deleted. Your alarms stay on this iPhone. An active subscription is not cancelled — manage it in Apple ID settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je account en profiel worden definitief verwijderd. Je wekkers blijven op deze iPhone. Een actief abonnement wordt niet opgezegd — beheer het in de instellingen van je Apple ID."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ton compte et ton profil sont définitivement supprimés. Tes réveils restent sur cet iPhone. Un abonnement actif n’est pas résilié — gère-le dans les réglages de ton identifiant Apple."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dein Konto und Profil werden dauerhaft gelöscht. Deine Wecker bleiben auf diesem iPhone. Ein aktives Abo wird nicht gekündigt — verwalte es in den Apple-ID-Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu cuenta y tu perfil se eliminan para siempre. Tus alarmas se quedan en este iPhone. Una suscripción activa no se cancela: gestiónala en los ajustes de tu ID de Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Account e profilo vengono eliminati definitivamente. Le tue sveglie restano su questo iPhone. Un abbonamento attivo non viene annullato — gestiscilo nelle impostazioni dell’ID Apple."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sua conta e seu perfil são excluídos de vez. Seus alarmes ficam neste iPhone. Uma assinatura ativa não é cancelada — gerencie nos ajustes do seu ID Apple."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A sua conta e o seu perfil são apagados de vez. Os seus alarmes ficam neste iPhone. Uma subscrição ativa não é cancelada — gira nos ajustes do seu ID Apple."
          }
        }
      }
    },
