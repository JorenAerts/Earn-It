    "Know someone who oversleeps? Send them Gloop and get Rise & Conquer, a brass fanfare that's not in the free plan." : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ken je iemand die zich vaak verslaapt? Stuur Gloop door en krijg Rise & Conquer, een koperfanfare die niet in de gratis versie zit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu connais quelqu’un qui a du mal à se lever ? Envoie-lui Gloop et reçois Rise & Conquer, une fanfare de cuivres absente de la version gratuite."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kennst du jemanden, der oft verschläft? Schick ihm Gloop und hol dir Rise & Conquer, eine Blechbläser-Fanfare, die es in der Gratisversion nicht gibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Conoces a alguien que siempre se queda dormido? Envíale Gloop y consigue Rise & Conquer, una fanfarria de metales que no está en el plan gratuito."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Conosci qualcuno che dorme sempre troppo? Mandagli Gloop e ottieni Rise & Conquer, una fanfara di ottoni non inclusa nel piano gratuito."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Conhece alguém que vive perdendo a hora? Mande o Gloop e ganhe Rise & Conquer, uma fanfarra de metais que não está no plano gratuito."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
