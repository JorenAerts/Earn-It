          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wecktöne dürfen bis zu 30 Sekunden lang sein; der Ausschnitt wiederholt sich, solange der Wecker klingelt. Verwende nur Audio, an dem du die Rechte hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los sonidos de alarma pueden durar hasta 30 segundos; el fragmento se repite mientras suena la alarma. Usa solo audio del que tengas los derechos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I suoni della sveglia possono durare fino a 30 secondi; la parte si ripete mentre la sveglia suona. Usa solo audio di cui hai i diritti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
