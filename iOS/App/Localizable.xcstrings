    "PRO missions come with a free trial. Tap one to try it, or keep Math on the free plan." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "PRO-Missionen gibt es mit einer kostenlosen Testphase. Tippe eine an, um sie auszuprobieren, oder bleib im Gratis-Plan bei Rechnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PRO missions come with a free trial. Tap one to try it, or keep Math on the free plan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las misiones PRO incluyen una prueba gratis. Toca una para probarla, o quédate con Matemáticas en el plan gratuito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les missions PRO incluent un essai gratuit. Touches-en une pour l’essayer, ou garde Calcul avec la version gratuite."
