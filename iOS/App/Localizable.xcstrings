    "%@ is a Pro sound. Continue to try it free, or pick Classic Beep." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ist ein Pro-Ton. Tippe auf Weiter, um ihn gratis zu testen, oder wähle Klassischer Piepton."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is a Pro sound. Continue to try it free, or pick Classic Beep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ es un sonido Pro. Continúa para probarlo gratis, o elige Pitido clásico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ est une sonnerie Pro. Continue pour l’essayer gratuitement, ou choisis Bip classique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ è una suoneria Pro. Continua per provarla gratis, o scegli Bip classico."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ is een Pro-geluid. Ga verder om het gratis te proberen, of kies Klassieke piep."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ é um som Pro. Continue para experimentar grátis ou escolha Bipe clássico."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ é um som Pro. Continue para experimentar grátis ou escolha Bipe clássico."
          }
        }
      }
    },
    "%@ is bouncing. Keep getting up on the first ring." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ hüpft. Steh weiter beim ersten Klingeln auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ está rebotando. Sigue levantándote a la primera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ rebondit. Continue à te lever à la première sonnerie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ sta rimbalzando. Continua ad alzarti al primo squillo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ stuitert. Blijf opstaan bij de eerste keer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ está quicando. Continue levantando no primeiro alarme."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ está a saltitar. Continue a levantar-se ao primeiro alarme."
          }
        }
      }
    },
    "%@ is doing fine. A few first-ring mornings and he'll bounce." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ geht es gut. Ein paar Morgen beim ersten Klingeln und er hüpft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ está bien. Unas cuantas mañanas a la primera y rebotará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ va bien. Quelques matins debout à la première sonnerie et il rebondira."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ sta bene. Qualche mattina al primo squillo e rimbalzerà."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ maakt het goed. Een paar ochtenden bij de eerste keer op en hij stuitert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ está bem. Algumas manhãs de primeira e ele vai quicar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ está bem. Algumas manhãs à primeira e ele vai saltitar."
          }
        }
      }
    },
