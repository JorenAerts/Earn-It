        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wie deze regels breekt, kan content verwijderd zien worden en uit Buddies geblokkeerd worden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Enfreindre ces règles peut entraîner la suppression de ton contenu et le blocage de ton compte dans Buddies."
          }
        },
        "de" : {
