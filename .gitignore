.DS_Store
# Xcode
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
build/
.build/
.swiftpm/
# Local signing (personal team id)
iOS/Config/Local.xcconfig
# Supabase client config (URL + publishable key)
iOS/Config/Supabase.xcconfig
# SwiftPM lock files inside local packages (generated)
iOS/Packages/*/Package.resolved

# workflow-audit plugin output
.workflow-audit/

# Web feedback board config (generated in CI from repo secrets)
Web/config.js

# Marketing screen recordings (iOS/scripts/marketing/record.sh), too big for git
docs/marketing/videos/

# App Store product page headers (PNG, ~130 MB): regenerate with SKIP_CAPTURE=1 iOS/scripts/screenshots/make.sh
iOS/fastlane/header/
# App Store screenshots (PNG, ~300 MB): regenerate with iOS/scripts/screenshots/make.sh (SKIP_CAPTURE=1 for re-compose only)
iOS/fastlane/screenshots/
